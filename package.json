{
  "name": "ai-multi-chat",
  "version": "1.0.0",
  "description": "AI 多站点一键问答桌面工具",
  "main": "dist/main/main/main.js",
  "private": true,
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "watch:main": "tsc -w -p tsconfig.main.json",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "dev": "npm run build:main && electron ."
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
